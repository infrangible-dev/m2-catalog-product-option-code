{
    "name": "infrangible/m2-catalog-product-option-code",
    "description": "Adds a code field to custom options and their values. The codes are saved with ordered items and returned by the order API, which makes it easier to pass options to ERP and other systems.",
    "type": "magento2-module",
    "version": "1.1.2",
    "license": "MIT",
    "keywords": [
        "Magento",
        "Magento 2",
        "Adobe Commerce",
        "Product options",
        "Integrations",
        "custom option codes",
        "option SKU for ERP",
        "custom options in the order API"
    ],
    "homepage": "https://github.com/infrangible-dev/m2-catalog-product-option-code",
    "authors": [
        {
            "name": "Andreas Knollmann",
            "email": "a.knollmann@seak.dev",
            "homepage": "https://www.seak.dev",
            "role": "Developer"
        }
    ],
    "require": {
        "php": ">=7.1",
        "magento/framework": "~102.0.0|~103.0.0",
        "infrangible/m2-foundation": "~2.2.0"
    },
    "autoload": {
        "files": [
            "src/registration.php"
        ],
        "psr-4": {
            "Infrangible\\CatalogProductOptionCode\\": "src"
        }
    }
}
